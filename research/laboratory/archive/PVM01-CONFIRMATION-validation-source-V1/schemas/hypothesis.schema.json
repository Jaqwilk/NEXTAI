{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextai.local/schemas/hypothesis.schema.json",
  "title": "Hypothesis event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "revision",
    "created_at",
    "updated_at",
    "title",
    "family",
    "statement",
    "motivation",
    "architectural_commitments",
    "predicted_signatures",
    "cheapest_falsification",
    "falsification_criteria",
    "evidence_for",
    "evidence_against",
    "evidence_experiment_ids",
    "confidence",
    "status",
    "next_experiment",
    "prior_art",
    "change_note"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "hypothesis_id": {"type": "string", "pattern": "^HYP-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "minLength": 4, "maxLength": 160},
    "family": {"type": "string", "minLength": 2, "maxLength": 80},
    "statement": {"type": "string", "minLength": 20},
    "motivation": {"type": "string", "minLength": 20},
    "architectural_commitments": {
      "type": "array",
      "items": {"type": "string", "minLength": 3},
      "minItems": 1,
      "uniqueItems": true
    },
    "predicted_signatures": {
      "type": "array",
      "items": {"type": "string", "minLength": 8},
      "minItems": 1
    },
    "cheapest_falsification": {"type": "string", "minLength": 20},
    "falsification_criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 8},
      "minItems": 1
    },
    "evidence_for": {"type": "array", "items": {"type": "string"}},
    "evidence_against": {"type": "array", "items": {"type": "string"}},
    "evidence_experiment_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EXP-[0-9]{8}-[0-9]{4}$"},
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {
      "enum": [
        "proposed",
        "testing",
        "promising",
        "uncertain",
        "falsified",
        "dormant",
        "promoted"
      ]
    },
    "next_experiment": {"type": ["string", "null"]},
    "prior_art": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "relationship"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "relationship": {"type": "string"}
        }
      }
    },
    "change_note": {"type": "string", "minLength": 3}
  }
}

