{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextai.local/schemas/experiment_result.schema.json",
  "title": "Experiment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "hypothesis_id",
    "plan_path",
    "plan_sha256",
    "benchmark",
    "budget",
    "started_at",
    "completed_at",
    "status",
    "integrity_before",
    "integrity_after",
    "environment",
    "candidates",
    "pareto_front",
    "interpretation_status"
  ],
  "$defs": {
    "integrity": {
      "type": "object",
      "required": ["ok", "problems"],
      "properties": {
        "ok": {"type": "boolean"},
        "problems": {"type": "array", "items": {"type": "string"}},
        "benchmark_version": {"type": ["string", "null"]},
        "protocol_version": {"type": "integer", "minimum": 1},
        "evaluator_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "candidate_bundle_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "checked_files": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["status", "completed_trials", "total_trials"],
      "properties": {
        "status": {"enum": ["complete", "partial", "failed"]},
        "completed_trials": {"type": "integer", "minimum": 0},
        "total_trials": {"type": "integer", "minimum": 0},
        "accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "program_induction_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "length_extrapolation_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "minimum_cell_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "minimum_combination_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "seed_count": {"type": "integer", "minimum": 0},
        "seed_accuracy_cv": {"type": ["number", "null"], "minimum": 0},
        "warm_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "near_equivalent_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "transfer_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "minimum_family_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "family_count": {"type": "integer", "minimum": 0},
        "family_router_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reuse_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reuse_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "false_reuse_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "continual_new_fact_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "continual_retention": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "conditional_probability_mae": {"type": ["number", "null"], "minimum": 0},
        "conditional_log_loss": {"type": ["number", "null"]},
        "normalized_rmse": {"type": ["number", "null"], "minimum": 0},
        "worst_file_normalized_rmse": {"type": ["number", "null"], "minimum": 0},
        "worst_transition_normalized_rmse": {"type": ["number", "null"], "minimum": 0},
        "worst_flight_normalized_rmse": {"type": ["number", "null"], "minimum": 0},
        "worst_condition_normalized_rmse": {"type": ["number", "null"], "minimum": 0},
        "teacher_forced_nrmse": {"type": ["number", "null"], "minimum": 0},
        "rollout_10_nrmse": {"type": ["number", "null"], "minimum": 0},
        "rollout_50_nrmse": {"type": ["number", "null"], "minimum": 0},
        "rollout_16_nrmse": {"type": ["number", "null"], "minimum": 0},
        "rollout_32_nrmse": {"type": ["number", "null"], "minimum": 0},
        "rollout_96_nrmse": {"type": ["number", "null"], "minimum": 0},
        "stable_rollout_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "oracle_gap_closed": {"type": ["number", "null"]},
        "privileged_support_gain": {"type": ["number", "null"]},
        "minimum_condition_transfer_gain": {"type": ["number", "null"]},
        "minimum_trajectory_transfer_gain": {"type": ["number", "null"]},
        "shared_vs_independent_gain": {"type": ["number", "null"]},
        "cross_family_transfer_gain": {"type": ["number", "null"]},
        "calibration_error": {"type": ["number", "null"], "minimum": 0},
        "prequential_loss": {"type": ["number", "null"], "minimum": 0},
        "bits_per_byte": {"type": ["number", "null"], "minimum": 0},
        "worst_span_bits_per_byte": {"type": ["number", "null"], "minimum": 0},
        "exact_span_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "critical_path_steps": {"type": ["number", "null"], "minimum": 0},
        "total_position_probabilities": {"type": ["number", "null"], "minimum": 0},
        "cold_bits_per_byte": {"type": ["number", "null"], "minimum": 0},
        "worst_file_bits_per_byte": {"type": ["number", "null"], "minimum": 0},
        "compression_ratio": {"type": ["number", "null"], "minimum": 0},
        "worst_phase_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "post_switch_recovery": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "recurrence_retention": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "distractor_interference": {"type": ["number", "null"], "minimum": 0},
        "circuit_nodes": {"type": ["number", "null"], "minimum": 0},
        "mean_query_ops": {"type": ["number", "null"]},
        "mean_warm_query_ops": {"type": ["number", "null"]},
        "warm_op_ratio": {"type": ["number", "null"]},
        "p50_latency_us": {"type": ["number", "null"]},
        "p95_latency_us": {"type": ["number", "null"]},
        "fit_seconds": {"type": ["number", "null"]},
        "fit_ops": {"type": ["number", "null"]},
        "meta_fit_ops": {"type": ["number", "null"]},
        "data_acquisition_ops": {"type": ["number", "null"]},
        "preprocessing_ops": {"type": ["number", "null"]},
        "adaptation_ops": {"type": ["number", "null"]},
        "fit_peak_bytes": {"type": ["number", "null"]},
        "state_bytes": {"type": ["number", "null"]},
        "peak_state_bytes": {"type": ["number", "null"]},
        "mean_input_ops": {"type": ["number", "null"]},
        "mean_probe_count": {"type": ["number", "null"], "minimum": 0},
        "mean_comparisons": {"type": ["number", "null"]},
        "mean_search_ops": {"type": ["number", "null"]},
        "mean_bytes_touched": {"type": ["number", "null"]},
        "update_ops": {"type": ["number", "null"]},
        "workload_ops": {"type": ["number", "null"]},
        "workload_ops_r1": {"type": ["number", "null"]},
        "workload_ops_r4": {"type": ["number", "null"]},
        "workload_ops_r16": {"type": ["number", "null"]},
        "update_latency_us": {"type": ["number", "null"]},
        "knowledge_compute_slope": {"type": ["number", "null"]},
        "knowledge_compute_slope_screening": {"type": ["number", "null"]},
        "knowledge_compute_slope_points": {"type": "integer", "minimum": 0},
        "knowledge_compute_slope_se": {"type": ["number", "null"], "minimum": 0},
        "knowledge_compute_slope_r2": {"type": ["number", "null"]},
        "depth_compute_slope": {"type": ["number", "null"]},
        "depth_compute_slope_screening": {"type": ["number", "null"]},
        "depth_compute_slope_points": {"type": "integer", "minimum": 0},
        "depth_compute_slope_se": {"type": ["number", "null"], "minimum": 0},
        "depth_compute_slope_r2": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{8}-[0-9]{4}$"},
    "hypothesis_id": {"type": "string", "pattern": "^HYP-[0-9]{4}$"},
    "plan_path": {"type": "string"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "benchmark": {"type": "string"},
    "evaluator_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "budget": {"enum": ["quick", "screen", "deep"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": ["complete", "complete_with_failures", "failed", "invalid_integrity"]
    },
    "integrity_before": {"$ref": "#/$defs/integrity"},
    "integrity_after": {"$ref": "#/$defs/integrity"},
    "environment": {"type": "object", "additionalProperties": true},
    "evaluation_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_sizes", "reasoning_depths", "queries_per_cell", "seeds"],
      "properties": {
        "knowledge_sizes": {"type": "array", "items": {"type": "integer"}},
        "reasoning_depths": {"type": "array", "items": {"type": "integer"}},
        "queries_per_cell": {"type": "integer", "minimum": 1},
        "seeds": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "scoring_seed_policy": {"type": ["object", "null"], "additionalProperties": true},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate", "status", "audit", "execution", "trials", "summary"],
        "properties": {
          "candidate": {"type": "string"},
          "status": {
            "enum": ["complete", "crash", "timeout", "memory_limit", "audit_failed"]
          },
          "audit": {"type": "object", "additionalProperties": true},
          "execution": {"type": ["object", "null"], "additionalProperties": true},
          "trials": {"type": "array", "items": {"type": "object"}},
          "summary": {"$ref": "#/$defs/summary"},
          "error_type": {"type": ["string", "null"]},
          "error": {"type": ["string", "null"]},
          "traceback": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "pareto_front": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "pareto_front_implementable": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "oracle_controls": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "pareto_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximize", "minimize"],
      "properties": {
        "maximize": {"type": "array", "items": {"type": "string"}},
        "minimize": {"type": "array", "items": {"type": "string"}}
      }
    },
    "interpretation_status": {"enum": ["pending_codex_analysis", "analyzed"]}
  }
}
